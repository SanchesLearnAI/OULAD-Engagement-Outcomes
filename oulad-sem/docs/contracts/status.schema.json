{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/oulad-sem/status.schema.json",
  "title": "OULAD run status",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "updated_at", "current_stage", "next_stage", "stages", "blocked"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^(run|sim)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" },
    "mode": { "enum": ["simulation", "full"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "current_stage": { "type": ["string", "null"], "pattern": "^S(0[0-9]|1[0-2])$" },
    "next_stage": { "type": ["string", "null"], "pattern": "^S(0[0-9]|1[0-2])$" },
    "stages": {
      "type": "object",
      "patternProperties": {
        "^S(0[0-9]|1[0-2])$": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pass", "fail", "warn", "skip", "pending"] },
            "started_at": { "type": ["string", "null"], "format": "date-time" },
            "finished_at": { "type": ["string", "null"], "format": "date-time" },
            "log": { "type": ["string", "null"] },
            "stage_json": { "type": ["string", "null"] },
            "artifacts": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "blocked": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["stage", "reason", "log_seq"],
          "properties": {
            "stage": { "type": "string" },
            "reason": { "type": "string" },
            "log_seq": { "type": "integer", "minimum": 1 },
            "error_type": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
